set -e

# Route prop types (PageProps, LayoutProps) are generated into .next/types and do not exist in a
# clean tree. Both ESLint and tsc need them, and lint-staged calls eslint directly rather than
# through `yarn lint`, so generate them up front.
yarn typegen

# Staged files: formatting + lint (zero warnings tolerated).
yarn lint-staged

# Whole-project checks. Both are fast enough to run on every commit and both catch problems
# that staged-file linting cannot: a change here can break a type or a test somewhere else.
yarn typecheck
yarn test
